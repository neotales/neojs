+uint32_t OwnFastElementKeys(Tagged<FixedArrayBase> elements) {
+  Tagged<FixedArray> array = Cast<FixedArray>(elements);
+  const uint32_t capacity = elements->length().value();
+  uint32_t count = 0;
+  for (uint32_t i = 0; i < capacity; i++) {
+    if (!IsTheHole(array->get(i))) count++;
+  }
+  return count;
+}
+
+template <typename Dictionary>
+uint32_t CountDictionaryStringKeys(Isolate* isolate,
+                                   DirectHandle<Dictionary> dictionary) {
+  ReadOnlyRoots roots(isolate);
+  uint32_t count = 0;
+  for (InternalIndex i : dictionary->IterateEntries()) {
+    Tagged<Object> key;
+    if (!dictionary->ToKey(roots, i, &key)) continue;
+    if (IsSymbol(key)) continue;
+    if (dictionary->DetailsAt(i).IsDontEnum()) continue;
+    count++;
+  }
+  return count;
+}
+
+template <typename Dictionary>
+BoundedOwnKeysStatus FillDictionaryStringKeys(
+    Isolate* isolate, DirectHandle<Dictionary> dictionary,
+    Handle<FixedArray> result, uint32_t start, uint32_t* produced) {
+  ReadOnlyRoots roots(isolate);
+  std::vector<int> indices;
+  indices.reserve(static_cast<size_t>(result->length().value()) - start);
+  for (InternalIndex i : dictionary->IterateEntries()) {
+    Tagged<Object> key;
+    if (!dictionary->ToKey(roots, i, &key)) continue;
+    if (IsSymbol(key)) continue;
+    if (dictionary->DetailsAt(i).IsDontEnum()) continue;
+    indices.push_back(i.as_int());
+  }
+  if (!Dictionary::kIsOrderedDictionaryType) {
+    std::sort(indices.begin(), indices.end(), [&](int left, int right) {
+      return dictionary->DetailsAt(InternalIndex(left)).dictionary_index() <
+             dictionary->DetailsAt(InternalIndex(right)).dictionary_index();
+    });
+  }
+  uint32_t position = start;
+  for (int index : indices) {
+    result->set(static_cast<int>(position++),
+                dictionary->NameAt(InternalIndex(index)));
+  }
+  *produced = position;
+  return BoundedOwnKeysStatus::kOk;
+}
