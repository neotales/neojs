+
+BoundedOwnKeysStatus GetOwnEnumerableStringKeysBounded(
+    Isolate* isolate, DirectHandle<JSReceiver> receiver, uint32_t max_keys,
+    uint32_t max_scan, Handle<FixedArray>* out_keys, uint32_t* out_scanned) {
+  *out_keys = Handle<FixedArray>();
+  *out_scanned = 0;
+  if (!IsJSObject(*receiver)) return BoundedOwnKeysStatus::kUnsupported;
+
+  DirectHandle<JSObject> object = Cast<JSObject>(receiver);
+  DirectHandle<Map> map(object->map(), isolate);
+  if (map->instance_type() != JS_OBJECT_TYPE) {
+    return BoundedOwnKeysStatus::kUnsupported;
+  }
+  if (IsAccessCheckNeeded(*object) || object->HasNamedInterceptor() ||
+      object->HasIndexedInterceptor() ||
+      IsCustomElementsReceiverMap(*map)) {
+    return BoundedOwnKeysStatus::kUnsupported;
+  }
+
+  uint64_t scanned = 0;
+  uint64_t key_count = 0;
+  const bool fast_properties = object->HasFastProperties();
+  uint32_t descriptor_count = 0;
+  uint32_t dictionary_capacity = 0;
+
+  ElementsKind elements_kind = object->GetElementsKind();
+  Tagged<FixedArrayBase> raw_elements = object->elements();
+  const uint32_t element_scan = raw_elements->length().value();
+  scanned += element_scan;
+  *out_scanned =
+      static_cast<uint32_t>(std::min<uint64_t>(scanned, UINT32_MAX));
+  if (scanned > max_scan) return BoundedOwnKeysStatus::kScanLimit;
+  if (element_scan != 0 &&
+      (!IsFastElementsKind(elements_kind) || !IsFixedArray(raw_elements))) {
+    return BoundedOwnKeysStatus::kUnsupported;
+  }
+  const uint32_t element_keys =
+      element_scan == 0 ? 0 : OwnFastElementKeys(raw_elements);
+  key_count += element_keys;
+
+  if (fast_properties) {
+    descriptor_count = static_cast<uint32_t>(map->NumberOfOwnDescriptors());
+    scanned += descriptor_count;
+    *out_scanned =
+        static_cast<uint32_t>(std::min<uint64_t>(scanned, UINT32_MAX));
+    if (scanned > max_scan) return BoundedOwnKeysStatus::kScanLimit;
+
+    DirectHandle<DescriptorArray> descriptors(map->instance_descriptors(),
+                                              isolate);
+    for (InternalIndex i : InternalIndex::Range(descriptor_count)) {
+      Tagged<Name> key = descriptors->GetKey(i);
+      if (IsNull(key) || IsSymbol(key)) continue;
+      if (descriptors->GetDetails(i).IsDontEnum()) continue;
+      key_count++;
+    }
+  } else {
+#if V8_ENABLE_SWISS_NAME_DICTIONARY_BOOL
+    DirectHandle<SwissNameDictionary> dictionary(
+        object->property_dictionary_swiss(), isolate);
+#else
+    DirectHandle<NameDictionary> dictionary(object->property_dictionary(),
+                                            isolate);
+#endif
+    dictionary_capacity = static_cast<uint32_t>(dictionary->Capacity());
+    scanned += dictionary_capacity;
+    *out_scanned =
+        static_cast<uint32_t>(std::min<uint64_t>(scanned, UINT32_MAX));
+    if (scanned > max_scan) return BoundedOwnKeysStatus::kScanLimit;
+    key_count += CountDictionaryStringKeys(isolate, dictionary);
+  }
+
+  if (key_count > max_keys) return BoundedOwnKeysStatus::kTooManyKeys;
+  if (key_count > static_cast<uint64_t>(std::numeric_limits<int>::max())) {
+    return BoundedOwnKeysStatus::kTooManyKeys;
+  }
+
+  Handle<FixedArray> result =
+      isolate->factory()->NewFixedArray(static_cast<int>(key_count));
+  if (result.is_null()) return BoundedOwnKeysStatus::kException;
+
+  // No JavaScript runs, but allocation can collect. Re-read through handles and
+  // verify the shape/dictionary/element capacity did not change.
+  DirectHandle<FixedArrayBase> elements(object->elements(), isolate);
+  if (elements->length().value() != element_scan) {
+    return BoundedOwnKeysStatus::kUnsupported;
+  }
+  if (fast_properties) {
+    if (map->NumberOfOwnDescriptors() !=
+        static_cast<int>(descriptor_count)) {
+      return BoundedOwnKeysStatus::kUnsupported;
+    }
+  } else {
+#if V8_ENABLE_SWISS_NAME_DICTIONARY_BOOL
+    DirectHandle<SwissNameDictionary> dictionary(
+        object->property_dictionary_swiss(), isolate);
+#else
+    DirectHandle<NameDictionary> dictionary(object->property_dictionary(),
+                                            isolate);
+#endif
+    if (static_cast<uint32_t>(dictionary->Capacity()) != dictionary_capacity) {
+      return BoundedOwnKeysStatus::kUnsupported;
+    }
+  }
+
+  uint32_t produced = 0;
+  if (element_keys != 0) {
+    DirectHandle<FixedArray> array(Cast<FixedArray>(*elements), isolate);
+    for (uint32_t i = 0; i < element_scan; i++) {
+      if (IsTheHole(array->get(i))) continue;
+      DirectHandle<String> key = isolate->factory()->Uint32ToString(i);
+      if (key.is_null()) return BoundedOwnKeysStatus::kException;
+      result->set(static_cast<int>(produced++), *key);
+    }
+  }
+
+  if (fast_properties) {
+    DirectHandle<DescriptorArray> final_descriptors(
+        map->instance_descriptors(), isolate);
+    for (InternalIndex i : InternalIndex::Range(descriptor_count)) {
+      Tagged<Name> key = final_descriptors->GetKey(i);
+      if (IsNull(key) || IsSymbol(key)) continue;
+      if (final_descriptors->GetDetails(i).IsDontEnum()) continue;
+      result->set(static_cast<int>(produced++), key);
+    }
+  } else {
+#if V8_ENABLE_SWISS_NAME_DICTIONARY_BOOL
+    DirectHandle<SwissNameDictionary> dictionary(
+        object->property_dictionary_swiss(), isolate);
+#else
+    DirectHandle<NameDictionary> dictionary(object->property_dictionary(),
+                                            isolate);
+#endif
+    BoundedOwnKeysStatus status =
+        FillDictionaryStringKeys(isolate, dictionary, result, produced, &produced);
+    if (status != BoundedOwnKeysStatus::kOk) return status;
+  }
+  if (produced != key_count) return BoundedOwnKeysStatus::kUnsupported;
+  *out_keys = result;
+  return BoundedOwnKeysStatus::kOk;
+}
