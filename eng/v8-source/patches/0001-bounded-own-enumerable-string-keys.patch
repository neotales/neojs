+namespace {
+template <typename T>
+Local<T> LocalFromRawHandle(const T* ptr) {
+  static_assert(sizeof(Local<T>) == sizeof(T*));
+  return *reinterpret_cast<const Local<T>*>(&ptr);
+}
+}  // namespace
+
+// Narrow C ABI for the opt-in neojs Node adapter. Keys are copied to the
+// caller's sink while the V8 handle scope is alive; no V8 handle crosses the
+// ABI. Returns the status values of i::BoundedOwnKeysStatus and the scan count.
+typedef void (*NeojsKeySink)(void* data, const uint8_t* bytes, size_t length);
+
+extern "C" V8_EXPORT int
+neojs_v8_get_own_enumerable_string_keys_bounded(
+    const Object* self, const Context* context, uint32_t max_keys,
+    uint32_t max_scan, uint32_t max_key_units, NeojsKeySink sink,
+    void* sink_data, uint32_t* out_len, uint32_t* out_scanned) {
+  if (out_len) *out_len = 0;
+  if (out_scanned) *out_scanned = 0;
+  if (self == nullptr || context == nullptr || sink == nullptr ||
+      out_len == nullptr || out_scanned == nullptr) {
+    return static_cast<int>(i::BoundedOwnKeysStatus::kUnsupported);
+  }
+
+  PrepareForExecutionScope api_scope{
+      LocalFromRawHandle(context), RCCId::kAPI_Object_GetPropertyNames};
+  i::Isolate* i_isolate = api_scope.i_isolate();
+  i::DirectHandle<i::JSReceiver> receiver =
+      i::Cast<i::JSReceiver>(Utils::OpenDirectHandle(self));
+  i::Handle<i::FixedArray> keys;
+  uint32_t scanned = 0;
+  i::BoundedOwnKeysStatus status = i::GetOwnEnumerableStringKeysBounded(
+      i_isolate, receiver, max_keys, max_scan, &keys, &scanned);
+  *out_scanned = scanned;
+  if (status != i::BoundedOwnKeysStatus::kOk) {
+    return static_cast<int>(status);
+  }
+
+  const uint32_t length = keys->ulength().value();
+  for (uint32_t index = 0; index < length; index++) {
+    i::DirectHandle<i::String> key = i::direct_handle(
+        i::Cast<i::String>(keys->get(index)), i_isolate);
+    if (key->length() > max_key_units) {
+      return static_cast<int>(i::BoundedOwnKeysStatus::kKeyTooLong);
+    }
+    Local<String> local_key = Utils::ToLocal(key);
+    Isolate* v8_isolate = reinterpret_cast<Isolate*>(i_isolate);
+    String::Utf8Value utf8(v8_isolate, local_key);
+    sink(sink_data, reinterpret_cast<const uint8_t*>(*utf8),
+         static_cast<size_t>(utf8.length()));
+  }
+  *out_len = length;
+  return static_cast<int>(i::BoundedOwnKeysStatus::kOk);
+}
