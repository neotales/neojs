+// Status returned by the narrow bounded own-key collector. The numeric values
+// are part of the private Rusty V8 bridge ABI used by neojs-node.
+enum class BoundedOwnKeysStatus : int {
+  kOk = 0,
+  kTooManyKeys = 1,
+  kScanLimit = 2,
+  kUnsupported = 3,
+  kMemory = 4,
+  kKeyTooLong = 5,
+  kException = -1,
+};
+
+// Collects own enumerable string keys of a narrow ordinary object.
+//
+// Supported: JS_OBJECT_TYPE with fast properties, no access check and no
+// interceptors, and either no elements or fast (non-double) elements.
+// Dictionary properties, dictionary elements, double elements, proxies, exotic
+// objects and all non-JS_OBJECT instances fail closed. `scanned` counts every
+// descriptor/element capacity slot inspected against `max_scan`; `keys`
+// contains at most `max_keys` strings. No JavaScript runs and no output is
+// allocated until both bounds pass.
+BoundedOwnKeysStatus GetOwnEnumerableStringKeysBounded(
+    Isolate* isolate, DirectHandle<JSReceiver> receiver, uint32_t max_keys,
+    uint32_t max_scan, Handle<FixedArray>* keys, uint32_t* scanned);
+
