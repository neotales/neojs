{
  "name": "neojs-docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Astro Starlight documentation site for NeoJS and NeoJS Lite.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev --port 4421",
    "build": "astro build",
    "preview": "astro preview --port 4421",
    "check": "astro check",
    "test": "node --test scripts/site.test.mjs",
    "verify": "pnpm check && pnpm build && pnpm test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/starlight": "0.43.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
